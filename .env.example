# Environment Configuration — GitHub Evalator
# Copy to .env and fill in values. NEVER commit actual secrets.

# AWS
AWS_REGION=us-east-1

# GitHub App
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=              # HMAC secret — store in Secrets Manager, not here
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=  # ARN of the Secrets Manager secret holding the PEM key

# DynamoDB
STATE_TABLE_NAME=github-evaluator-state

# SQS
EVENT_QUEUE_URL=
EVENT_DLQ_URL=

# S3
EVIDENCE_BUCKET_NAME=github-evaluator-evidence

# Bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Step Functions
PROPOSAL_WORKFLOW_ARN=
PR_INTEGRITY_WORKFLOW_ARN=
