# Environment Configuration — GitHub Evalator
# Copy to .env and fill in values. NEVER commit actual secrets.

# AWS
AWS_REGION=us-east-1

# GitHub App
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET_ARN=          # Secrets Manager secret ARN holding webhook HMAC secret (never plaintext)
GITHUB_APP_PRIVATE_KEY_SECRET_ARN=  # Secrets Manager secret ARN holding GitHub App PEM private key

# DynamoDB
STATE_TABLE_NAME=github-evaluator-state

# SQS Standard
EVENT_QUEUE_URL=
EVENT_DLQ_URL=

# S3 (Bucket name must be stage/account-qualified and globally unique)
EVIDENCE_BUCKET_NAME=

# Bedrock (Configurable active model supporting native structured JSON Schema outputs)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-6

# Step Functions
PROPOSAL_WORKFLOW_ARN=
PR_INTEGRITY_WORKFLOW_ARN=

# Amplify / Dashboard
DASHBOARD_API_ENDPOINT=
